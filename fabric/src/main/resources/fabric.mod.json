{
  "schemaVersion": 1,
  "id": "building_palette",
  "version": "${version}",
  "name": "Building Palette",
  "description": "Alt-scroll building shapes with conserved material and half-block multipart details.",
  "authors": [
    "jens-hj"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.jensh.buildingpalette.fabric.FabricPalette"
    ],
    "modmenu": [
      "dev.jensh.buildingpalette.client.PaletteModMenu"
    ],
    "client": [
      "dev.jensh.buildingpalette.fabric.FabricPaletteClient"
    ]
  },
  "mixins": [
    "building_palette.mixins.json",
    {
      "config": "building_palette.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "clutternomore": ">=3.1.3 <3.2",
    "offgrid": ">=1.0.5 <1.1"
  },
  "suggests": {
    "modmenu": "*",
    "travelersbackpack": "*"
  },
  "icon": "assets/building_palette/icon.png"
}
